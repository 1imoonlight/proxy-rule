#!name = GLaDOS 每日签到
#!desc = 每天 9 点签到 GLaDOS。首次使用：开启插件后用 Safari 登录 glados.cloud 并打开控制台，自动抓取 Cookie
#!homepage = https://glados.cloud

[Script]
http-request ^https:\/\/glados\.cloud\/api\/user\/ script-path=https://raw.githubusercontent.com/1imoonlight/proxy-rule/refs/heads/main/script/glados_cookie.js, requires-body=false, timeout=10, tag=GLaDOS_Cookie抓取
cron "0 9 * * *" script-path=https://raw.githubusercontent.com/1imoonlight/proxy-rule/refs/heads/main/script/glados_checkin.js, timeout=30, tag=GLaDOS_每日签到

[MITM]
hostname = glados.cloud
